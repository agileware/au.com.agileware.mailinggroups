<?xml version="1.0"?>
<extension key="au.com.agileware.mailinggroups" type="module">
  <file>mailinggroups</file>
  <name>Mailing Groups ACL Check</name>
  <description>Remove groups that the user does not have access to from Mailings when created from an existing mailing.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Agileware</author>
    <email>support@agileware.com.au</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">http://github.com/agileware/au.com.agileware.mailinggroups</url>
    <url desc="Documentation">http://github.com/agileware/au.com.agileware.mailinggroups</url>
    <url desc="Support">http://agileware.com.au</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-12</releaseDate>
  <version>1.0.2</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <civix>
    <namespace>CRM/Mailinggroups</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
